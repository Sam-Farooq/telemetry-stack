# Compose reads these for the collector and the two services. Copy to .env.
ELASTICSEARCH_URL=http://elasticsearch:9200
KAFKA_BOOTSTRAP=kafka:9092
ORDERS_TOPIC=orders.placed
CONSUMER_GROUP=settlement

# Where the services send OTLP. The agent, never the gateway directly: the
# gateway is a fixed number of replicas and the agent is per host.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-agent:4317
OTEL_SERVICE_NAME=checkout-api
OTEL_RESOURCE_ATTRIBUTES=service.version=1.4.2,deployment.environment=local

# checkout-api's synthetic request rate, and the share of requests that fail.
REQUESTS_PER_SECOND=40
ERROR_RATE=0.02
SLOW_RATE=0.03
